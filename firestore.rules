rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Roles live on users/{uid}.role: Developer > Master > Admin > Staff (empty).
    // Master and Developer can do everything; the first Developer is set in the Firebase console.
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", ""); }
    function rank(r) { return {"developer": 3, "master": 2, "admin": 1}.get(r, 0); }
    function isSuper() { return signedIn() && role() in ["master", "developer"]; }
    function isAdmin() { return signedIn() && role() in ["admin", "master", "developer"]; }
    // Test data ("data uji", lib/test-data.ts): only a Developer deletes it, and only documents marked UJI.
    function isDeveloper() { return signedIn() && role() == "developer"; }
    function testBank(id) { return get(/databases/$(database)/documents/banks/$(id)).data.get("accountNo", "").matches("(?i)UJI-.*"); }

    // Change history: add only, attributed to the writer.
    match /logs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by.uid == request.auth.uid;
    }

    // users/{uid}: anyone edits their own profile but never its role.
    // Master/Developer change only the role, of a user ranked below them, to a role below
    // theirs: a Developer's role can never be changed, a Master's only by a Developer.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && !("role" in request.resource.data);
      allow update: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.get("role", "") == resource.data.get("role", ""))
        || (isSuper()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role"])
          && request.resource.data.role in ["", "master", "admin"]
          && rank(resource.data.get("role", "")) < rank(role())
          && rank(request.resource.data.role) < rank(role())));
    }

    // Chart of accounts: accounts/{6-digit number}; the number never changes, accounts are deactivated, never deleted.
    match /accounts/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.code == code && code.matches("[0-9]{6}");
      allow update: if signedIn() && request.resource.data.code == resource.data.code;
    }

    // Report lines: reportLines/{NR..|LR..}; the code never changes, lines are deactivated, never deleted.
    match /reportLines/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.code == code && code.matches("(NR|LR)[0-9]{2,3}");
      allow update: if signedIn() && request.resource.data.code == resource.data.code;
    }

    // Own bank accounts: banks/{auto id}; deactivated, never deleted.
    match /banks/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isDeveloper() && resource.data.get("accountNo", "").matches("(?i)UJI-.*");
    }

    // Buku bank rows (lib/bank-book.ts), on a bank that exists. A journaled row is locked: only its
    // journal link changes (when the journal is cancelled), and it can't be deleted.
    match /bankTransactions/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && exists(/databases/$(database)/documents/banks/$(request.resource.data.bank));
      allow update: if signedIn() && exists(/databases/$(database)/documents/banks/$(request.resource.data.bank))
        && (resource.data.get("journal", null) == null || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["journal"]));
      allow delete: if (signedIn() && resource.data.get("journal", null) == null) || (isDeveloper() && testBank(resource.data.bank));
    }

    // Journals (lib/journal.ts): created and cancelled (deleted), never edited, except the Saldo awal
    // journals (the real one and the Developer's test one), which are replaced as a whole.
    match /journals/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.total is number && request.resource.data.lines.size() > 0;
      allow update: if signedIn() && id in ["SALDO-AWAL", "SALDO-AWAL-UJI"] && request.resource.data.total is number && request.resource.data.lines.size() > 0;
      allow delete: if signedIn();
    }

    // Departments: departments/{code}; the code never changes, deactivated, never deleted.
    match /departments/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.code == code;
      allow update: if signedIn() && request.resource.data.code == resource.data.code;
      allow delete: if isDeveloper() && code.matches("(?i)UJI.*");
    }

    // Inventory (lib/inventory.ts): items with their live stock (never below zero), and movements that
    // are only added (a mistake is fixed with an opposite movement), attributed to the writer.
    match /inventoryItems/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.stock is number && request.resource.data.stock >= 0;
      allow delete: if isDeveloper() && resource.data.get("code", "").matches("(?i)UJI-.*");
    }
    // Item code reservations: inventoryCodes/{code} = { item }, so codes stay unique.
    match /inventoryCodes/{code} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.item is string;
      allow delete: if signedIn();
    }
    match /inventoryMovements/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by.uid == request.auth.uid
        && exists(/databases/$(database)/documents/inventoryItems/$(request.resource.data.item));
      allow delete: if isDeveloper() && resource.data.get("itemCode", "").matches("(?i)UJI-.*");
    }

    // Number counters ({BBM|BBK}-{bank id}-YYYY-MM = { last }); they only go up.
    match /counters/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && request.resource.data.last > resource.data.last;
      allow delete: if isDeveloper() && testBank(id.split("-")[1]);
    }

    // Everything else is closed until a feature adds its own rule here.
  }
}
